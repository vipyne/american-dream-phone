# https://accounts.pipecat.daily.co/sign-up
DAILY_SAMPLE_ROOM_URL=https://yourdomain.daily.co/yourroom # (optional: for joining the bot to the same room repeatedly for local dev)

DAILY_API_KEY="pipecat.daily.co" Under `Settings` menu of agent, in `Daily` tab.

DAILY_API_URL=https://api.daily.co/v1

# https://app.play.ht/api/keys
PLAYHT_USER_ID=
PLAYHT_API_KEY=

CARTESIA_API_KEY="play.cartesia.ai/keys"

OPENAI_API_KEY="platform.openai.com/api-keys"

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY

# https://docs.pipecat.ai/server/utilities/smart-turn
FAL_SMART_TURN_API_KEY=

# Demo mode (set to "false" to disable guardrails)
DEMO_MODE=true

# ── Offline mode: swap Deepgram/Cartesia/Anthropic for Whisper-MLX/Kokoro/Ollama.
# Daily transport (and PSTN dialout) still works — "offline" = no paid AI APIs.
# Requires Apple Silicon, Ollama installed, and the sibling locat repo's models.
# Start Ollama first: ./scripts/run_ollama.sh
OFFLINE=false
# Optional offline knobs (defaults shown):
#LLM_MODEL=qwen2.5:14b
#OLLAMA_BASE_URL=http://localhost:11434/v1
#WHISPER_MODEL=LARGE_V3_TURBO   # TINY | MEDIUM | LARGE_V3 | LARGE_V3_TURBO
#KOKORO_VOICE=af_heart
# Model weight locations — default to the sibling locat repo's downloads:
#HF_HOME=../locat/models/huggingface
#KOKORO_MODEL_PATH=../locat/models/kokoro/kokoro-v1.0.onnx
#KOKORO_VOICES_PATH=../locat/models/kokoro/voices-v1.0.bin
#OLLAMA_MODELS=../locat/models/ollama
# Secret to unlock dev mode (BYOPN). Pass as ?dev=YOUR_SECRET in the URL.
DEV_SECRET=

# for prompt substitutions:
CONSTITUENT_ADDRESS="123 street name. apartment 123. city name, zip code"
CONSTITUENT_PHONE_NUMBER="000-000-0000"